/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src 'self'; form-action 'none'; frame-ancestors 'none'; base-uri 'self'

# The question file changes with the instrument, so it must never go stale in a
# cache the visitor cannot clear. Everything else is content-addressed by deploy.
/data/*
  Cache-Control: public, max-age=300, must-revalidate

/*.png
  Cache-Control: public, max-age=604800

/styles.css
  Cache-Control: public, max-age=3600

/app.js
  Cache-Control: public, max-age=3600
